# ---- copy to .env and fill in. Never commit .env ----
NODE_ENV=production

# PUBLIC listener (what nginx proxies): /api/subscribe, public files, signed links
PORT=3000
# Public https URL of the API: used to build public/shared file links
PUBLIC_BASE_URL=https://api.asveli.com

# ADMIN listener: panel + admin API. Loopback only, never proxied, reached through an SSH tunnel.
# Leave these two as they are. (docker-compose.yml sets the container-side values itself.)
ADMIN_PORT=3001
# ADMIN_HOST=127.0.0.1
# Extra Host names accepted by the panel, e.g. if you reach it over a private VPN name. Default: localhost, 127.0.0.1, [::1]
# ADMIN_ALLOWED_HOSTS=
# Optional extra filter by client IP (only meaningful with a VPN)
# ADMIN_IP_ALLOWLIST=

# Random secret, >= 32 chars:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Ключ шифрования персональных данных (паспорт, IBAN, e-mail, телефон, адрес…). ОБЯЗАТЕЛЕН в production, минимум 32 символа.
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"   СДЕЛАЙТЕ БЭКАП: без него данные не восстановить.
DATA_ENCRYPTION_KEY=
# В production по умолчанию 1: без 2FA сотрудник не может работать с модулями. 0 — отключить (не рекомендуется).
REQUIRE_2FA=1
PLATFORM_CURRENCY=EUR
# Сколько раз в час один сотрудник может «показать» персональные данные
REVEAL_RATE_LIMIT=20

# The four coming-soon sites that may call POST /api/subscribe from a browser
ALLOWED_ORIGINS=https://asveli.pl,https://asveli.eu,https://asveli.com,https://asveli.shop
# Browsers allowed to call the shop API (/api/store, /api/seller). Put the domain where the storefront is hosted.
STORE_ORIGINS=https://asveli.com,https://www.asveli.com
SITES=asveli.pl,asveli.eu,asveli.com,asveli.shop

# ---- storage ----
# local = files on the server disk (dev),  drive = Google Drive API
STORAGE_DRIVER=drive
MAX_UPLOAD_MB=2048

# Google Drive (run `npm run drive-token` once to get the refresh token)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_NAME=asveli-storage

# ---- AI layer (optional) ----
# You do NOT have to edit this: the owner sets the provider, API key, models and limits in the admin (AI → Подключения AI) and it applies at once.
# Values here are only the defaults; "Reset to server settings" in the admin returns to them. The key saved in the admin is stored encrypted in the database.
# mock = offline demo (default) | gemini = Google Gemini API | openai = OpenAI or any compatible server | ollama = native Ollama
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=                     # openai-compatible / ollama only. Gemini always uses Google's official host
AI_MODEL=                        # empty = provider default (gemini-2.5-flash / gpt-4o-mini / qwen2.5:7b-instruct)
AI_EMBED_MODEL=                  # empty = provider default (gemini-embedding-001 / text-embedding-3-small / bge-m3)
AI_IMAGE_MODEL=                  # empty = provider default (gemini-2.5-flash-image / gpt-image-1)
AI_DAILY_LIMIT=2000              # calls per 24 h: protects you from a runaway bill
AI_REVIEW_CONFIDENCE=85          # cards below this confidence go to the "needs review" queue
# Allow base URLs that point to private/loopback addresses (Ollama on this machine, test servers). Leave off in production unless you need it.
AI_ALLOW_PRIVATE_HOSTS=0
